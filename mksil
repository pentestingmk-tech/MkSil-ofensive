class TacticalAgent:
    def __init__(self, data):
        self.data = data

    def get_narrative_analysis(self):
        if not self.data["services"]:
            return "[-] INSUFFICIENT DATA: No attack surface detected.", [], 0
        total_risk = 0
        attack_surface = []
        for port, svc in self.data["services"].items():
            name = svc["name"].lower()
            product = svc.get("product", "").lower()
            version = svc.get("version", "").lower()
            risk = 0
            if "http" in name: risk += 5
            elif "smb" in name or port == "445": risk += 8
            elif "db" in name or "sql" in name: risk += 6
            elif "ssh" in name: risk += 3
            port_exps = [e for e in self.data["exploits"] if re.search(rf"\b{re.escape(port)}\b", e)]
            if port_exps: risk += min(10, len(port_exps) * 2)
            keywords = [name, product]
            critical_nuclei = [n for n in self.data["nuclei"] if "critical" in n.lower()]
            if any(any(k in n.lower() for k in keywords if k) for n in critical_nuclei): risk += 10
            if risk > 30: risk = 30 + (risk - 30) * 0.5
            total_risk += risk
            exposure = "CRITICAL" if risk >= 20 else "HIGH" if risk >= 15 else "MEDIUM" if risk >= 8 else "LOW"
            attack_surface.append({"port": port, "service": svc["name"], "product": product, "version": version, "risk": round(risk, 1), "exposure": exposure})
        attack_surface.sort(key=lambda x: (x["risk"]), reverse=True)
        analysis = f"=== [ SENIOR PENTEST STRATEGY REPORT ] ===\n\nOBJETIVO: {self.data['target']}\nRISK SCORE: {round(total_risk, 1)}\n\n"
        for item in attack_surface:
            analysis += f"[PORT {item['port']}] {item['service']} -> EXPOSICIÓN: {item['exposure']} | SCORE: {item['risk']}\n"
        return analysis, attack_surface, round(total_risk, 1)


class DeepIntelligence:
    def __init__(self, data):
        self.data = data

    def get_ai_strategy(self, callback):
        if not ollama:
            self._fallback_analysis(callback)
            return
        critical_services = {k: v for i, (k, v) in enumerate(self.data["services"].items()) if i < 5}
        context = {
            "target": self.data["target"],
            "services_summary": list(critical_services.values()),
            "top_vulns": self.data["nuclei"][:5],
            "top_paths": self.data["fuzzer"][:5],
        }
        prompt = f"Eres un experto en Red Team. Plan de ataque conciso para: {json.dumps(context)}. Responde en ESPAÑOL."
        try:
            response = ollama.chat(
                model="llama3",
                messages=[
                    {"role": "system", "content": "Responde siempre en formato breve y técnico."},
                    {"role": "user", "content": prompt},
                ],
                stream=True,
            )
            for chunk in response:
                callback(chunk["message"]["content"])
        except Exception as e:
            callback(f"[-] ERROR IA: {str(e)}")

    def _fallback_analysis(self, callback):
        callback("[*] Análisis táctico local (ollama no disponible)\n\n")
        for port, svc in self.data["services"].items():
            name = svc["name"].lower()
            if "http" in name:
                callback(f"► Puerto {port} ({svc['name']}): Vector de entrada web.\n")
                callback("  → Buscar: directorios ocultos, paneles admin, uploads.\n")
                callback("  → Feroxbuster ya ejecutado. Revisar rutas encontradas.\n")
            elif "smb" in name or port == "445":
                callback(f"► Puerto {port} (SMB): RIESGO ALTO.\n")
                callback("  → Intentar: enum4linux, smbclient, eternalblue (MS17-010).\n")
            elif "sql" in name or "db" in name:
                callback(f"► Puerto {port} ({svc['name']}): Base de datos expuesta.\n")
                callback("  → Intentar: brute force credenciales, default creds, SQLi.\n")
            elif "ssh" in name:
                callback(f"► Puerto {port} (SSH): Brute force o credenciales débiles.\n")
            elif "ftp" in name:
                callback(f"► Puerto {port} (FTP): Anónimo login, escritura directa.\n")
            elif "smtp" in name:
                callback(f"► Puerto {port} (SMTP): Enumeración de usuarios, relay.\n")
        if self.data["nuclei"]:
            callback("\n► VULNS CRÍTICAS ENCONTRADAS:\n")
            for v in self.data["nuclei"][:5]:
                callback(f"  ! {v}\n")
        callback("\n► ESTRATEGIA RECOMENDADA:\n")
        callback("  1. Priorizar puertos CRITICAL/HIGH del reporte táctico.\n")
        callback("  2. Explotar vulnerabilidades de nuclei confirmadas.\n")
        callback("  3. Escalada de privilegios post-explotación.\n")
        callback("  4. Instalar ollama para análisis IA profundo: pip install ollama\n")


class MksilApp:
    def __init__(self, root):
        self.root = root
