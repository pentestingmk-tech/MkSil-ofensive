        self.root.geometry("1100x580")
        self.root.configure(bg="#050505")
        self.scan_mode = tk.StringVar(value="fast")
        self.scan_data = {"target": "", "services": {}, "nuclei": [], "exploits": [], "ports": [], "fuzzer": [], "ai_strategy": ""}
